# Credenciais do PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=DespensaViva_DB

# Segredo JWT do backend (TROQUE em producao!)
JWT_SECRET=troque_este_segredo_em_producao
JWT_EXPIRES_IN=7d

# Porta publica do app web (usado se acessar o Nginx diretamente sem Caddy)
WEB_PORT=80

# Dominio publico para HTTPS (Caddy/Let's Encrypt)
DOMAIN=https://seu-dominio.com
