# Syntax= docker/dockerfile:1

# ---------- 1. Build do Flutter Web ----------
FROM ghcr.io/gmeligio/flutter-web:3.47.2 AS build-web

USER root
RUN git config --global --add safe.directory /home/flutter/sdks/flutter

WORKDIR /src/app

COPY app/pubspec.yaml app/pubspec.lock* ./
RUN flutter pub get

COPY app/ .
RUN chown -R flutter:flutter /src/app

USER flutter
RUN flutter build web --release --dart-define=API_URL=/api
# Entrypoints do Flutter têm URL FIXA (main.dart.js, flutter_bootstrap.js).
# O build-id do Flutter (.last_build_id) NÃO muda entre builds com o mesmo SDK,
# então usar ?v=<build-id> ainda colide com cache antigo. Usa-se hash do
# CONTEÚDO de cada arquivo: se o build mudou, a URL muda e CDN/navegador
# buscam a versão nova (sem precisar purgar cache).
RUN sed -i "s|main\.dart\.js|main.dart.js?v=$(md5sum /src/app/build/web/main.dart.js | cut -c1-12)|g" /src/app/build/web/flutter_bootstrap.js && \
    sed -i "s|flutter_bootstrap\.js|flutter_bootstrap.js?v=$(md5sum /src/app/build/web/flutter_bootstrap.js | cut -c1-12)|g" /src/app/build/web/index.html

# ---------- 2. Servidor web (Nginx) ----------
FROM nginx:alpine AS web

# Remove a página default e copia o build
RUN rm -rf /usr/share/nginx/html/* && \
    rm -f /etc/nginx/conf.d/default.conf

COPY --from=build-web /src/app/build/web/ /usr/share/nginx/html/

# Configuração com proxy reverso para a API
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
