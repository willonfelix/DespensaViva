# Syntax= docker/dockerfile:1

# ---------- 1. Build do Flutter Web ----------
FROM ghcr.io/cirruslabs/flutter:stable AS build-web

WORKDIR /src/app

# Aproveita o cache de dependências do pub
COPY app/pubspec.yaml app/pubspec.lock* ./
RUN flutter pub get

# Código-fonte
COPY app/ .

# Compila o web apontando a API para o mesmo domínio (proxy /api via Nginx)
RUN flutter build web --release --dart-define=API_URL=/api

# ---------- 2. Servidor web (Nginx) ----------
FROM nginx:alpine AS web

# Remove a página default e copia o build
RUN rm -rf /usr/share/nginx/html/* && \
    rm -f /etc/nginx/conf.d/default.conf

COPY --from=build-web /src/app/build/web/ /usr/share/nginx/html/

# Configuração com proxy reverso para a API
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
