# Copie este arquivo para .env e ajuste os valores conforme o seu banco.
PORT=3007

# Conexão com o PostgreSQL (formato: postgresql://usuario:senha@host:porta/banco)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dispensa

# Segredo usado para assinar os tokens JWT (troque em produção!)
JWT_SECRET=despensaviva_super_secret_change_me
JWT_EXPIRES_IN=7d