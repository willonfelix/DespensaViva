# DespensaViva - Caddy proxy reverso
# Cloudflare cuida do HTTPS. Caddy serve HTTP interno.

:3007 {
    # API
    handle /api/* {
        reverse_proxy backend:3007
    }

    # App web (Nginx serve os estáticos do Flutter)
    handle {
        reverse_proxy web:80
    }

    # headers de segurança
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
    }
}
